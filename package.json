{
  "name": "narrowbit",
  "version": "0.1.0",
  "description": "Context-efficiency engine for coding agents: task + repository -> minimum sufficient context.",
  "type": "module",
  "bin": { "narrowbit": "bin/narrowbit.js", "nb": "bin/narrowbit.js" },
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
