    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "typescript": "^5.9.0" },
  "devDependencies": { "@types/node": "^22.10.0" },
  "license": "UNLICENSED",
  "private": true
}
